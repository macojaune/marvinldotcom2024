---
import { getCollection } from "astro:content"
import Layout from "../../layouts/Layout.astro"
import List from "../../components/List.astro"
import ListItem from "../../components/ListItem.astro"
import HomeProjectCard from "../../components/HomeProjectCard.astro"
import MaggmaAnnouncement from "../../components/MaggmaAnnouncement.astro"
import { persona } from "../../persona"
import { buildBreadcrumbList } from "../../seo"

const clientProjects = await getCollection("project", ({ data }) => {
  if (data.isClient === true)
    return import.meta.env.PROD ? data.isDraft !== true : true
})
const myProjects = await getCollection("project", ({ data }) => {
  if (data.isClient === false)
    return import.meta.env.PROD ? data.isDraft !== true : true
})
const breadcrumb = buildBreadcrumbList([
  { name: "Accueil", url: "/" },
  { name: "Projets", url: "/projets/" }
])
const sortedPersonalProjects = myProjects.sort(
  (a, b) => b.data.updatedAt.getTime() - a.data.updatedAt.getTime()
)
const sortedClientProjects = clientProjects.sort(
  (a, b) => b.data.updatedAt.getTime() - a.data.updatedAt.getTime()
)
---

<Layout
  wide
  title={persona.seo.projectTitle}
  desc={persona.seo.projectDesc}
  structuredData={breadcrumb}
>
  <section class='grid gap-5 py-6 md:py-10'>
    <h1
      class='max-w-5xl font-display text-6xl leading-[0.95] tracking-[-0.04em] text-l/primary dark:text-d/primary sm:text-7xl md:text-8xl xl:text-[6rem]'
    >
      Tous les projets.
    </h1>
    <p
      class='max-w-3xl text-base leading-8 text-l/secondary dark:text-d/muted md:text-[1.18rem]'
    >
      Produits personnels et réalisations client.
    </p>
  </section>

  <section class='grid gap-10 py-8'>
    <div
      class='flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between'
    >
      <h2
        class='font-display text-3xl leading-[1.05] tracking-[-0.03em] text-l/primary dark:text-d/primary sm:text-4xl lg:text-5xl'
      >
        Projets personnels.
      </h2>
    </div>

    <div
      class='grid grid-cols-1 gap-x-4 gap-y-4 sm:grid-cols-2 sm:gap-x-6 sm:gap-y-10 lg:grid-cols-3 lg:gap-10'
    >
      {
        sortedPersonalProjects.map((project) => (
          <HomeProjectCard
            slug={project.slug}
            title={project.data.title}
            desc={project.data.description}
            date={project.data.createdAt}
            types={project.data.types}
            status={project.data.status}
            url={`/projets/${project.slug}`}
          />
        ))
      }
    </div>
  </section>

  <MaggmaAnnouncement />

  <section class='grid gap-8 py-8'>
    <div class='flex flex-col gap-3'>
      <h2
        class='font-display text-3xl leading-[1.05] tracking-[-0.03em] text-l/primary dark:text-d/primary sm:text-4xl lg:text-5xl'
      >
        Projets clients.
      </h2>
    </div>
    <List>
      {
        sortedClientProjects.map((project) => (
          <ListItem
            title={project.data.title}
            desc={project.data.description}
            date={project.data.createdAt}
            url={`/projets/${project.slug}`}
          />
        ))
      }
    </List>
  </section>
</Layout>
