---
import { getCollection } from "astro:content"
import EditorialHeader from "../../components/EditorialHeader.astro"
import EditorialProse from "../../components/EditorialProse.astro"
import MaggmaAnnouncement from "../../components/MaggmaAnnouncement.astro"
import ProjectPreview from "../../components/ProjectPreview.astro"
import ProjectTableOfContents from "../../components/ProjectTableOfContents"
import Layout from "@/layouts/Layout.astro"
import { buildBreadcrumbList, getCanonicalUrl } from "../../seo"
// 1. Generate a new path for every collection entry
export async function getStaticPaths() {
  const projectEntries = await getCollection("project", ({ data }) => {
    return import.meta.env.PROD ? data.isDraft !== true : true
  })
  return projectEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry }
  }))
}
// 2. For your template, you can get the entry directly from the prop
const { entry } = Astro.props
const { Content, headings } = await entry.render()
const articleHeadings = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3
)
const previewProjectSlugs = [
  "kalot-municipales",
  "stay-connect",
  "o-mas-la",
  "pani-limye-pani-dlo",
  "lejustecoin-jeu-en-ligne-sur-l-immobilier-en-guadeloupe",
  "extension-chrome-odesli",
  "days-since-scolo",
  "macojaune",
  "marvinl-point-com",
  "quilivreou",
  "sauve-ta-saint-valentin"
] as const
const projectPreview = previewProjectSlugs.find((slug) => slug === entry.slug)
const formattedCreatedAt = new Date(entry.data.createdAt).toLocaleDateString(
  "fr-FR",
  {
    day: "numeric",
    month: "long",
    year: "numeric"
  }
)
const formattedUpdatedAt = new Date(entry.data.updatedAt).toLocaleDateString(
  "fr-FR",
  {
    day: "numeric",
    month: "long",
    year: "numeric"
  }
)
const description = `Découvre ${entry.data.title}, un projet web conçu par MarvinL.com. Explore son contexte, ses choix techniques et la manière dont l'idée a pris forme en ligne.`
const canonical = getCanonicalUrl(`/projets/${entry.slug}/`)
const json = {
  "@type": "CreativeWork",
  "@id": `${canonical}#project`,
  name: entry.data.title,
  headline: entry.data.title,
  url: canonical,
  description,
  creator: {
    "@id": "https://www.marvinl.com/#person"
  },
  publisher: {
    "@id": "https://www.marvinl.com/#service"
  },
  inLanguage: "fr-FR",
  keywords: entry.data.technos.join(", "),
  genre: entry.data.isClient ? "Projet client" : "Projet personnel",
  dateCreated: new Date(entry.data.createdAt).toISOString(),
  dateModified: new Date(entry.data.updatedAt).toISOString()
}
const breadcrumb = buildBreadcrumbList([
  { name: "Accueil", url: "/" },
  { name: "Projets", url: "/projets/" },
  { name: entry.data.title, url: `/projets/${entry.slug}/` }
])
---

<Layout
  wide
  title={entry.data.title + " − Un projet MarvinL.com"}
  desc={description}
  canonical={canonical}
  ogType='article'
  publishedTime={entry.data.createdAt}
  modifiedTime={entry.data.updatedAt}
  structuredData={[json, breadcrumb]}
>
  <EditorialHeader
    backHref='/projets'
    backLabel='Retour aux projets'
    eyebrow={entry.data.isClient ? "Projet client" : "Projet personnel"}
    title={entry.data.title}
    description={entry.data.description}
    meta={[
      `Publié le ${formattedCreatedAt}`,
      `Mis à jour le ${formattedUpdatedAt}`
    ]}
    shareDescription={`Découvre ${entry.data.title}, un projet présenté par MarvinL.com. Développeur web fullstack et entrepreneur depuis la Guadeloupe.`}
    shareTitle={entry.data.title + " − Un projet MarvinL.com"}
  />

  <div
    class:list={[
      "project-reading-layout grid gap-x-12 gap-y-8",
      {
        "has-preview": projectPreview,
        "has-toc": articleHeadings.length > 0
      }
    ]}
  >
    {
      projectPreview && (
        <div class='project-media'>
          <ProjectPreview project={projectPreview} />
        </div>
      )
    }

    {
      articleHeadings.length > 0 && (
        <aside class='project-toc lg:sticky lg:top-8'>
          <ProjectTableOfContents headings={articleHeadings} client:load />
        </aside>
      )
    }

    <div class='project-article min-w-0'>
      <EditorialProse>
        <Content />
      </EditorialProse>

      <section class='grid max-w-[46rem] gap-4 py-8'>
        <p
          class='font-mono text-[0.68rem] uppercase tracking-[0.3em] text-l/tertiary dark:text-d/accent'
        >
          Technologies utilisées
        </p>
        <ul class='flex flex-wrap gap-x-4 gap-y-2'>
          {
            entry.data.technos.map((tech: string) => (
              <li class='font-mono text-[0.72rem] uppercase tracking-[0.22em] text-l/secondary dark:text-d/subtle'>
                {tech}
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>

  <MaggmaAnnouncement />
</Layout>

<style>
  .project-reading-layout {
    grid-template-areas: "article";
  }

  .project-reading-layout.has-preview {
    grid-template-areas:
      "media"
      "article";
  }

  .project-reading-layout.has-toc {
    grid-template-areas:
      "toc"
      "article";
  }

  .project-reading-layout.has-preview.has-toc {
    grid-template-areas:
      "media"
      "toc"
      "article";
  }

  .project-media {
    grid-area: media;
  }

  .project-toc {
    grid-area: toc;
  }

  .project-article {
    grid-area: article;
  }

  @media (min-width: 64rem) {
    .project-reading-layout {
      grid-template-columns: minmax(0, 46rem);
      grid-template-areas: "article";
      justify-content: center;
      align-items: start;
    }

    .project-reading-layout.has-preview {
      grid-template-areas:
        "media"
        "article";
    }

    .project-reading-layout.has-toc {
      grid-template-columns: minmax(0, 46rem) minmax(12rem, 16rem);
      grid-template-areas: "article toc";
      justify-content: space-between;
    }

    .project-reading-layout.has-preview.has-toc {
      grid-template-areas:
        "media toc"
        "article toc";
    }
  }
</style>
