---
import { getCollection } from "astro:content"
import { sort } from "radash"
import Footer from "../components/Footer.astro"
import HomeHero from "../components/HomeHero.astro"
import MaggmaAnnouncement from "../components/MaggmaAnnouncement.astro"
import HomeProjectCard from "../components/HomeProjectCard.astro"
import Link from "../components/Link.astro"
import { home } from "../home"
import Layout from "../layouts/Layout.astro"
import { persona } from "../persona"
import { buildFaqPage, buildWebPage } from "../seo"

const projects = await getCollection("project", ({ data }) => {
  if (data.isClient === false)
    return import.meta.env.PROD ? data.isDraft !== true : true
})
const articles = await getCollection("blog", ({ data }) =>
  import.meta.env.PROD ? data.isDraft !== true : true
)

const sortedProjects = sort(projects, (project) => project.data.updatedAt, true)
const sortedArticles = sort(articles, (article) => article.data.createdAt, true)

const featuredProjects = sortedProjects.slice(0, 4)
const moreProjects = sortedProjects.slice(4, 7)
const recentArticles = sortedArticles.slice(0, 3)
const homePage = buildWebPage({
  name: persona.seo.title,
  description: persona.seo.description,
  url: "/"
})
const faqPage = buildFaqPage(home.faq.items)
---

<Layout
  title={persona.seo.title}
  desc={persona.seo.description}
  structuredData={[homePage, faqPage]}
  newsletterEmphasis
  wide
>
  <HomeHero
    eyebrow={home.hero.eyebrow}
    title={home.hero.title}
    ctas={home.ctas}
    projects={featuredProjects.map((project) => ({
      slug: project.slug,
      title: project.data.title
    }))}
  />

  <MaggmaAnnouncement />

  <section id='projets' class='grid scroll-mt-8 gap-10 py-8'>
    <div
      class='flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between'
    >
      <div class='max-w-3xl space-y-3'>
        <h2
          class='font-display text-5xl leading-[0.9] tracking-[-0.04em] text-l/primary dark:text-d/primary md:text-7xl xl:text-[6.2rem]'
        >
          {home.projects.title}
        </h2>
      </div>

      <div class='hidden md:block'>
        <Link url='/projets' target='_self' variant='subtle'>
          Tous les projets
        </Link>
      </div>
    </div>

    {
      featuredProjects.length > 0 && (
        <div class='grid grid-cols-1 gap-x-4 gap-y-4 sm:grid-cols-2 sm:gap-x-6 sm:gap-y-10 lg:gap-10'>
          {featuredProjects.map((project) => (
            <HomeProjectCard
              slug={project.slug}
              title={project.data.title}
              desc={project.data.description}
              date={project.data.createdAt}
              types={project.data.types}
              status={project.data.status}
              url={`/projets/${project.slug}`}
            />
          ))}
        </div>
      )
    }

    {
      moreProjects.length > 0 && (
        <>
          <div class='flex justify-center pt-2 md:hidden'>
            <Link url='/projets' target='_self' variant='subtle'>
              Tous les projets
            </Link>
          </div>

          <div class='hidden gap-5 pt-6 md:grid'>
            <p class='font-mono text-[0.68rem] uppercase tracking-[0.3em] text-l/secondary dark:text-d/subtle'>
              Autres projets
            </p>
            <div class='grid grid-cols-3 gap-8'>
              {moreProjects.map((project) => (
                <a
                  href={`/projets/${project.slug}`}
                  class='group -mx-3 flex min-w-0 flex-col gap-3 rounded-xl px-3 py-3 transition duration-200 hover:translate-x-1 hover:bg-l/primary/[0.035] focus-visible:translate-x-1 focus-visible:bg-l/primary/[0.035] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-l/tertiary dark:hover:bg-white/[0.06] dark:focus-visible:bg-white/[0.06] dark:focus-visible:ring-d/accent'
                >
                  <div class='flex items-start justify-between gap-3'>
                    <p class='font-mono text-[0.66rem] uppercase tracking-[0.25em] text-l/secondary dark:text-d/subtle'>
                      {project.data.createdAt.toLocaleDateString("fr-FR", {
                        month: "short",
                        year: "numeric"
                      })}
                    </p>
                    {project.data.status && (
                      <p class='text-right font-mono text-[0.66rem] uppercase tracking-[0.2em] text-l/tertiary dark:text-d/accent'>
                        {project.data.status}
                      </p>
                    )}
                  </div>
                  <h3 class='font-display text-3xl leading-[0.94] tracking-[-0.03em] text-l/primary transition group-hover:text-l/tertiary group-focus-visible:text-l/tertiary dark:text-d/primary dark:group-hover:text-d/tertiary dark:group-focus-visible:text-d/tertiary'>
                    {project.data.title}
                  </h3>
                  {project.data.description && (
                    <p class='line-clamp-2 text-base leading-7 text-l/secondary dark:text-d/muted'>
                      {project.data.description}
                    </p>
                  )}
                </a>
              ))}
            </div>
          </div>
        </>
      )
    }
  </section>

  <section
    class='grid gap-8 py-8 lg:grid-cols-[minmax(0,0.88fr)_minmax(0,1.12fr)] lg:gap-12'
  >
    <div class='faq-title-container space-y-4'>
      <h2
        class='faq-title max-w-3xl font-display text-5xl leading-[0.9] tracking-[-0.04em] text-l/primary dark:text-d/primary md:text-7xl xl:text-[5.8rem]'
      >
        {home.faq.title}
      </h2>
    </div>

    <div class='grid gap-8'>
      {
        home.faq.items.map((item) => (
          <article class='space-y-3'>
            <h3 class='font-display text-3xl leading-[0.95] tracking-[-0.03em] text-l/primary dark:text-d/primary md:text-4xl'>
              {item.question}
            </h3>
            <p class='max-w-2xl text-base leading-8 text-l/secondary dark:text-d/muted'>
              {item.answer}
            </p>
          </article>
        ))
      }
    </div>
  </section>

  <section
    aria-labelledby='home-writing-title'
    class='grid gap-10 py-8 lg:grid-cols-[minmax(0,0.92fr)_minmax(0,1.08fr)] lg:gap-16'
  >
    <div class='space-y-4'>
      <h2
        id='home-writing-title'
        class='font-display text-5xl leading-[0.9] tracking-[-0.04em] text-l/primary dark:text-d/primary md:text-7xl xl:text-[5.8rem]'
      >
        {home.writing.title}
      </h2>
      <p
        class='max-w-xl text-base leading-8 text-l/secondary dark:text-d/muted md:text-xl'
      >
        {home.writing.body}
      </p>
      {
        articles.length > 0 && (
          <Link url='/blog' target='_self' variant='subtle'>
            Voir les écrits
          </Link>
        )
      }
    </div>

    {
      recentArticles.length > 0 ? (
        <ul class='divide-y divide-l/primary/15 border-y border-l/primary/15 dark:divide-d/primary/20 dark:border-d/primary/20'>
          {recentArticles.map((article) => (
            <li>
              <a
                href={`/blog/${article.slug}`}
                class='motion-link group block py-6 outline-none transition-colors duration-150 focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-l/tertiary dark:focus-visible:ring-d/accent sm:py-7'
              >
                <div class='min-w-0 space-y-3'>
                  <p class='font-mono text-[0.66rem] uppercase tracking-[0.2em] text-l/secondary dark:text-d/accent'>
                    {article.data.createdAt.toLocaleDateString("fr-FR", {
                      month: "long",
                      year: "numeric"
                    })}
                  </p>
                  <h3 class='font-body text-2xl font-semibold leading-[1.25] tracking-[-0.015em] text-l/primary transition-colors duration-150 group-hover:text-l/tertiary group-focus-visible:text-l/tertiary dark:text-d/primary dark:group-hover:text-d/accent dark:group-focus-visible:text-d/accent md:text-[1.75rem]'>
                    {article.data.title}
                  </h3>
                  {article.data.description && (
                    <p class='max-w-prose text-base leading-7 text-l/secondary dark:text-d/muted'>
                      {article.data.description}
                    </p>
                  )}
                </div>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class='text-base leading-8 text-l/secondary dark:text-d/muted'>
          Aucun nouvel article pour le moment.
        </p>
      )
    }
  </section>

  <Footer />
</Layout>

<style>
  .faq-title-container {
    container-type: inline-size;
  }
  .faq-title {
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
    font-size: min(3rem, 16cqw);
  }
  @media (min-width: 768px) {
    .faq-title {
      font-size: min(4.5rem, 16cqw);
    }
  }
  @media (min-width: 1280px) {
    .faq-title {
      font-size: min(5.8rem, 16cqw);
    }
  }
</style>
