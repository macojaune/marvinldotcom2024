---
import { getCollection } from "astro:content"
import Layout from "../layouts/Layout.astro"
import { ProjectBracket } from "../components/ProjectComparison"
import { persona } from "../persona"

const projectIdeas = await Astro.locals.db.query.project.findMany({
  with: { votes: true },
  where: (project, { eq }) => eq(project.active, false)
})
const activeProject = await Astro.locals.db.query.project.findFirst({
  where: (project, { eq }) => eq(project.active, true)
})
const publishedProjects = await getCollection("project", ({ data }) =>
  import.meta.env.PROD ? data.isDraft !== true : true
)
const normalizeProjectName = (value?: string | null) =>
  value?.toLocaleLowerCase("fr").replace(/[^a-z0-9]/g, "")
const activeContentProject = activeProject
  ? publishedProjects.find(
      (project) =>
        normalizeProjectName(project.slug) ===
          normalizeProjectName(activeProject.slug) ||
        normalizeProjectName(project.data.title) ===
          normalizeProjectName(activeProject.title)
    )
  : undefined
const activeProjectUrl = activeContentProject
  ? `/projets/${activeContentProject.slug}`
  : activeProject?.url
---

<Layout
  wide
  title={`Idées de projets − ${persona.brandName}`}
  desc='Vote pour le prochain projet que Marvin développera.'
>
  <section class='grid gap-5 py-6 md:py-10'>
    <p
      class='font-mono text-[0.68rem] uppercase tracking-[0.3em] text-l/tertiary dark:text-d/accent'
    >
      Idées
    </p>
    <h1
      class='max-w-5xl font-display text-5xl leading-[0.9] tracking-[-0.04em] text-l/primary dark:text-d/primary md:text-7xl xl:text-[6rem]'
    >
      Quel projet je code ensuite ?
    </h1>
    <p
      class='max-w-2xl text-base leading-8 text-l/secondary dark:text-d/muted md:text-[1.18rem]'
    >
      Vote pour l’idée que tu veux voir sortir en premier.
    </p>
  </section>

  {
    activeProject && (
      <section class='grid gap-7 border-y border-l/primary/15 py-9 dark:border-d/primary/20 md:grid-cols-[minmax(0,0.7fr)_minmax(0,1.3fr)] md:items-end md:py-12'>
        <div>
          <p class='font-mono text-[0.68rem] uppercase tracking-[0.3em] text-l/secondary dark:text-d/subtle'>
            Projet sélectionné
          </p>
          <h2 class='mt-3 font-display text-4xl leading-[0.92] tracking-[-0.03em] text-l/primary dark:text-d/primary md:text-6xl'>
            {activeProject.title}
          </h2>
        </div>
        <div class='space-y-5'>
          {activeProject.description && (
            <p class='max-w-xl text-base leading-8 text-l/secondary dark:text-d/muted md:text-lg'>
              {activeProject.description}
            </p>
          )}
          {activeProjectUrl && (
            <a
              href={activeProjectUrl}
              class='inline-flex items-center gap-3 font-mono text-[0.72rem] uppercase tracking-[0.22em] text-l/tertiary outline-none transition hover:gap-4 hover:text-l/primary focus-visible:gap-4 focus-visible:text-l/primary dark:text-d/accent dark:hover:text-d/primary dark:focus-visible:text-d/primary'
            >
              Voir le projet <span aria-hidden='true'>→</span>
            </a>
          )}
        </div>
      </section>
    )
  }

  <section
    class='idea-vote-panel -mx-5 overflow-hidden bg-[#2a0d3e] px-5 py-10 text-[#fff4cf] md:-mx-8 md:px-8 md:py-12 lg:mx-0 lg:rounded-2xl lg:px-12'
  >
    <ProjectBracket
      projects={projectIdeas}
      activeProjectId={activeProject?.id ?? 0}
      client:load
    />
  </section>
</Layout>
