---
import { getCollection } from "astro:content"
import EditorialHeader from "../../components/EditorialHeader.astro"
import EditorialProse from "../../components/EditorialProse.astro"
import ProjectTableOfContents from "../../components/ProjectTableOfContents"
import Layout from "@/layouts/Layout.astro"
import { buildBreadcrumbList, getCanonicalUrl } from "../../seo"
// 1. Generate a new path for every collection entry
export async function getStaticPaths() {
  const blogEntries = await getCollection("blog", ({ data }) => {
    return import.meta.env.PROD ? data.isDraft !== true : true
  })
  return blogEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry }
  }))
}
// 2. For your template, you can get the entry directly from the prop
const { entry } = Astro.props
const { Content, headings } = await entry.render()
const articleHeadings = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3
)
const formattedCreatedAt = new Date(entry.data.createdAt).toLocaleDateString(
  "fr-FR",
  {
    day: "numeric",
    month: "long",
    year: "numeric"
  }
)
const formattedUpdatedAt = new Date(entry.data.updatedAt).toLocaleDateString(
  "fr-FR",
  {
    day: "numeric",
    month: "long",
    year: "numeric"
  }
)
const description =
  entry.data.description ??
  `Article de MarvinL.com sur le développement web, les produits numériques et l’entrepreneuriat depuis la Guadeloupe.`
const canonical = getCanonicalUrl(`/blog/${entry.slug}/`)
const json = {
  "@type": "BlogPosting",
  "@id": `${canonical}#article`,
  headline: `${entry.data.title} − Un article MarvinL.com`,
  url: canonical,
  description,
  author: {
    "@id": "https://www.marvinl.com/#person"
  },
  publisher: {
    "@id": "https://www.marvinl.com/#person"
  },
  mainEntityOfPage: canonical,
  inLanguage: "fr-FR",
  datePublished: new Date(entry.data.createdAt).toISOString(),
  dateModified: new Date(entry.data.updatedAt).toISOString()
}
const breadcrumb = buildBreadcrumbList([
  { name: "Accueil", url: "/" },
  { name: "Blog", url: "/blog/" },
  { name: entry.data.title, url: `/blog/${entry.slug}/` }
])
---

<Layout
  wide
  title={entry.data.title}
  desc={description}
  canonical={canonical}
  ogType='article'
  publishedTime={entry.data.createdAt}
  modifiedTime={entry.data.updatedAt}
  structuredData={[json, breadcrumb]}
>
  <EditorialHeader
    backHref='/blog'
    backLabel='Retour au blog'
    eyebrow='Article'
    title={entry.data.title}
    description={description}
    meta={[
      `Publié le ${formattedCreatedAt}`,
      `Mis à jour le ${formattedUpdatedAt}`
    ]}
    shareDescription={description}
    shareTitle={`Je viens de lire "${entry.data.title}" sur le blog MarvinL.com`}
  />

  <div
    class:list={[
      "article-reading-layout grid gap-x-12 gap-y-8",
      { "has-toc": articleHeadings.length > 0 }
    ]}
  >
    {
      articleHeadings.length > 0 && (
        <aside class='article-toc lg:sticky lg:top-8'>
          <ProjectTableOfContents headings={articleHeadings} client:load />
        </aside>
      )
    }

    <div class='article-body min-w-0'>
      <EditorialProse>
        <Content />
      </EditorialProse>
    </div>
  </div>
</Layout>

<style>
  .article-reading-layout {
    grid-template-areas: "article";
  }

  .article-reading-layout.has-toc {
    grid-template-areas:
      "toc"
      "article";
  }

  .article-toc {
    grid-area: toc;
  }

  .article-body {
    grid-area: article;
  }

  @media (min-width: 64rem) {
    .article-reading-layout {
      grid-template-columns: minmax(0, 46rem);
      grid-template-areas: "article";
      justify-content: center;
      align-items: start;
    }

    .article-reading-layout.has-toc {
      grid-template-columns: minmax(0, 46rem) minmax(12rem, 16rem);
      grid-template-areas: "article toc";
      justify-content: space-between;
    }
  }
</style>
