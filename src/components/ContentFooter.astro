---
import { persona } from "../persona"
import Link from "./Link.astro"
interface Props {
  isRoot?: boolean
}
const { isRoot = false } = Astro.props
---

<footer class='my-12 max-w-[46rem] lg:my-16'>
  {
    !isRoot && (
      <h2 class='font-display text-4xl leading-[0.92] tracking-[-0.03em] text-l/primary dark:text-d/primary md:mb-3 md:text-5xl'>
        Un nouveau projet client ?
      </h2>
    )
  }
  <div class='mt-4 grid gap-4'>
    <p class='w-full text-base leading-8 text-l/secondary dark:text-d/muted'>
      Les missions solo, c’est fini. Pour construire un site, une application ou
      un outil IA avec l’équipe, direction
      <Link target='_blank' url='https://maggma.studio/#contact'>
        MAGGMA Studio
      </Link>.
    </p>
    <p class='w-full text-sm text-l/secondary dark:text-d/muted'>
      Ou me retrouver ici :
      {
        persona.contacts.map((c) => (
          <span class="uppercase after:content-['_/_'] last:after:content-none">
            <Link
              target='_blank'
              url={c.url}
              noDecorate
              class='mx-1 font-mono text-[0.68rem] uppercase tracking-[0.24em]'
            >
              {c.title}
            </Link>
          </span>
        ))
      }
    </p>
  </div>
</footer>
