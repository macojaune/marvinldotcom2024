---
import type ButtonProps from "./types"

type Props = ButtonProps

const { url = Astro.url, description, via } = Astro.props

const params = new URLSearchParams({ url: String(url) })
if (description) params.set("text", description)
if (via) params.set("via", via)
const URL = `https://twitter.com/intent/tweet?${params}`
---

<a
  class='share-action'
  aria-label='Partager sur X (nouvel onglet)'
  target='_blank'
  href={URL}
  rel='noopener noreferrer'
>
  <slot>
    <svg
      aria-hidden='true'
      xmlns='http://www.w3.org/2000/svg'
      viewBox='0 0 24 24'
      width='20'
      height='20'
    >
      <!-- X mark: Simple Icons, https://github.com/simple-icons/simple-icons/blob/develop/icons/x.svg -->
      <path
        fill='currentColor'
        d='M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z'
      ></path>
    </svg>
  </slot>
</a>
